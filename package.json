{
  "name": "shirones-pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Build & publish pipeline for the shirones npm package",
  "scripts": {
    "version:next": "node scripts/resolve-version.mjs",
    "test:version": "node --test scripts/semver.test.mjs",
    "test:templates": "node --test scripts/template-rewrites.test.mjs",
    "test:collections": "node --test scripts/collections-dts.test.mjs",
    "templates": "node scripts/prepare-templates.mjs",
    "build": "node scripts/build-package.mjs",
    "validate": "node scripts/validate.mjs",
    "override-test": "node scripts/override-test.mjs",
    "all": "pnpm test:version && pnpm test:templates && pnpm test:collections && pnpm templates && pnpm build && pnpm validate && SHIRONES_OVERTEST_SKIP_BUILD=1 pnpm override-test"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.93",
    "@iconify-json/simple-icons": "^1.2.97"
  }
}
