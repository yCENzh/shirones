{
  "name": "shirones-pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Build & publish pipeline for the shirones npm package",
  "scripts": {
    "version:next": "node scripts/resolve-version.mjs",
    "templates": "node scripts/prepare-templates.mjs",
    "build": "node scripts/build-package.mjs",
    "validate": "node scripts/validate.mjs",
    "all": "pnpm templates && pnpm build && pnpm validate"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.88",
    "@iconify-json/simple-icons": "^1.2.93"
  }
}
